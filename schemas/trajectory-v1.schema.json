{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentHarness observable trajectory event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "run_id", "sequence", "kind", "payload", "source_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string"},
    "run_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["mcp_send", "mcp_receive", "mcp_timeout", "transport_latency", "llm_decision", "blocked"]},
    "payload": {"type": "object"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
